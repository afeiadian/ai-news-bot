# 复制此文件为 .env 并填入真实值
# cp .env.example .env

# Miniflux（部署后填入）
MINIFLUX_URL=https://your-miniflux.railway.app
MINIFLUX_API_KEY=your_miniflux_api_key

# Claude API
ANTHROPIC_API_KEY=your_claude_api_key

# RSSHub（部署后填入）
RSSHUB_URL=https://your-rsshub.railway.app

# GitHub Pages（自动，不需要手动填）
# GITHUB_TOKEN 由 GitHub Actions 自动注入
